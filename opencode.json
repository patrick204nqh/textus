{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "textus": {
      "type": "local",
      "command": [
        "bundle",
        "exec",
        "exe/textus",
        "mcp",
        "serve"
      ],
      "enabled": true
    }
  },
  "lsp": {
    "yaml-ls": {
      "command": [
        "node_modules/.bin/yaml-language-server",
        "--stdio"
      ],
      "extensions": [
        "yml",
        "yaml"
      ]
    },
    "json-ls": {
      "command": [
        "node_modules/.bin/vscode-json-languageserver",
        "--stdio"
      ],
      "extensions": [
        "json"
      ]
    },
    "marksman": {
      "command": [
        "marksman",
        "serve"
      ],
      "extensions": [
        "md"
      ]
    },
    "ruby-lsp": {
      "command": [
        "bundle",
        "exec",
        "ruby-lsp"
      ],
      "extensions": [
        "rb",
        "erb",
        "builder",
        "rake",
        "ru"
      ]
    }
  },
  "permission": {
    "edit": {
      "*": "allow",
      ".textus/data/knowledge/**": "deny",
      ".textus/data/artifacts/**": "deny",
      "docs/**": "deny",
      "README.md": "deny",
      "CONTRIBUTING.md": "deny",
      "SECURITY.md": "deny",
      "CLAUDE.md": "deny",
      "AGENTS.md": "deny",
      "CHANGELOG.md": "deny",
      "CODE_OF_CONDUCT.md": "deny",
      ".mcp.json": "deny"
    }
  },
  "instructions": [
    "AGENTS.md"
  ]
}
