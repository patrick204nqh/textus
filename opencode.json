{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "textus": {
      "type": "local",
      "command": [
        "bundle",
        "exec",
        "exe/textus",
        "mcp",
        "serve"
      ],
      "enabled": true
    }
  },
  "lsp": {
    "yaml-ls": {
      "command": ["node_modules/.bin/yaml-language-server", "--stdio"],
      "extensions": ["yml", "yaml"]
    },
    "json-ls": {
      "command": ["node_modules/.bin/vscode-json-languageserver", "--stdio"],
      "extensions": ["json"]
    },
    "marksman": {
      "command": ["marksman", "serve"],
      "extensions": ["md"]
    },
    "ruby-lsp": {
      "command": ["bundle", "exec", "ruby-lsp"],
      "extensions": ["rb", "erb", "builder", "rake", "ru"]
    }
  },
  "instructions": [
    "AGENTS.md"
  ]
}
