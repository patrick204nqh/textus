#!/usr/bin/env ruby
# bin/db — open the .textus store.db in sqlite3
#
# Usage:  bin/db [sqlite3 args...]
#   No args  → interactive sqlite3 shell
#   With args → runs as `sqlite3 -header -column <args>`

require "fileutils"

ROOT = File.expand_path("..", __dir__)
DB   = File.join(ROOT, ".textus/db/store.db")

unless File.exist?(DB)
  warn "no store.db at #{DB}"
  exit 1
end

sqlite = %w[sqlite3 -header -column]
if ARGV.empty?
  exec(*sqlite, DB)
else
  exec(*sqlite, DB, *ARGV)
end
