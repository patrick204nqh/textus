{
  "statusLine": {
    "type": "command",
    "command": "${CLAUDE_PROJECT_DIR}/.claude-plugin/claude/statusline.sh"
  },
  "hooks": {
    "PreToolUse": [{
      "matcher": "Edit|Write",
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PROJECT_DIR}/.claude-plugin/claude/hooks/enforce.sh",
        "timeout": 10
      }]
    }],
    "SessionStart": [{
      "type": "command",
      "command": "${CLAUDE_PROJECT_DIR}/.claude-plugin/claude/hooks/session-start.sh",
      "timeout": 10
    }]
  }
}
